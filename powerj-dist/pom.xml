<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.powerj</groupId>
        <artifactId>powerj-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>powerj-dist</artifactId>
    <packaging>pom</packaging>
    <name>PowerJ Distribution</name>
    <description>
        Construit l'application autonome (runtime jlink + lanceur jpackage) avec le profil "dist",
        et l'installeur Windows avec le profil "installer".
    </description>

    <properties>
        <dist.modules>${project.build.directory}/modules</dist.modules>
        <dist.jpackage>${project.build.directory}/jpackage</dist.jpackage>
        <dist.main>io.powerj.shell/io.powerj.shell.Main</dist.main>
        <!-- jpackage executable name; overridden on Windows (windows profile). -->
        <dist.jpackage.exe>${java.home}/bin/jpackage</dist.jpackage.exe>
        <!-- Platform-specific options for the application image. -->
        <dist.platform.args></dist.platform.args>
        <!-- Names the archive: <os>-<arch>, set by the profiles below for the machine that builds (the image is made with
             the jlink and jpackage of the JDK that runs Maven, so it is the platform of that machine). -->
        <dist.platform>linux-x64</dist.platform>
        <!-- What jpackage makes under dist.jpackage: a folder, but on macOS an application bundle. -->
        <dist.image>powerj</dist.image>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.powerj</groupId>
            <artifactId>powerj-shell</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <dist.jpackage.exe>${java.home}/bin/jpackage.exe</dist.jpackage.exe>
                <dist.platform.args>--win-console</dist.platform.args>
                <dist.platform>windows-x64</dist.platform>
            </properties>
        </profile>

        <!-- Windows on ARM: after "windows", so that its name wins when both are active. -->
        <profile>
            <id>windows-arm</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <dist.platform>windows-aarch64</dist.platform>
            </properties>
        </profile>

        <profile>
            <id>linux-arm</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <dist.platform>linux-aarch64</dist.platform>
            </properties>
        </profile>

        <profile>
            <id>mac-intel</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <dist.platform>macos-x64</dist.platform>
                <dist.image>powerj.app</dist.image>
            </properties>
        </profile>

        <profile>
            <id>mac-arm</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <dist.platform>macos-aarch64</dist.platform>
                <dist.image>powerj.app</dist.image>
            </properties>
        </profile>

        <!-- Self-contained application image: powerj/ folder (launcher + Java runtime) and zip archive. -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <!-- jpackage requires a numeric version (0.2.0, without -SNAPSHOT). -->
                            <execution>
                                <id>parse-version</id>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-modules</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${dist.modules}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${dist.jpackage}"/>
                                        <!-- macOS refuses an app-version whose first number is 0 (CFBundleVersion): while the
                                             project is at 0.x, the bundle says 1.x (the version command of the launcher tells the truth). -->
                                        <condition property="dist.app.major" value="1" else="${parsedVersion.majorVersion}">
                                            <and>
                                                <os family="mac"/>
                                                <equals arg1="${parsedVersion.majorVersion}" arg2="0"/>
                                            </and>
                                        </condition>
                                        <exec executable="${dist.jpackage.exe}" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="app-image"/>
                                            <arg value="--name"/>
                                            <arg value="powerj"/>
                                            <arg value="--app-version"/>
                                            <arg value="${dist.app.major}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}"/>
                                            <arg value="--vendor"/>
                                            <arg value="PowerJ"/>
                                            <arg value="--module-path"/>
                                            <arg value="${dist.modules}"/>
                                            <arg value="--module"/>
                                            <arg value="${dist.main}"/>
                                            <!-- The whole Java SE library can be called from the shell (spec FR-52). -->
                                            <arg value="--add-modules"/>
                                            <!-- jdk.unsupported: Ctrl+C interception by JLine (sun.misc.Signal).
                                                 jdk.jfr, jdk.management: the profiler of the perf mode (FR-76). -->
                                            <arg value="java.se,jdk.unsupported,jdk.jfr,jdk.management,io.powerj.cmdlets"/>
                                            <!-- JLine accesses the native console (FFM / native library). -->
                                            <arg value="--java-options"/>
                                            <arg value="--enable-native-access=org.jline.terminal.ffm,org.jline.nativ,io.powerj.core"/>
                                            <!-- The profiler is an optional dependency of powerj-core: it is only resolved when asked.
                                                 jdk.unsupported is in the image but nothing requires it: the third-party modules
                                                 that do (javafx.graphics of powerj-fx) need it in the boot layer. -->
                                            <arg value="--java-options"/>
                                            <arg value="--add-modules=jdk.jfr,jdk.management,jdk.unsupported"/>
                                            <arg value="--jlink-options"/>
                                            <arg value="--strip-java-debug-attributes --no-header-files --no-man-pages"/>
                                            <arg value="--dest"/>
                                            <arg value="${dist.jpackage}"/>
                                            <arg line="${dist.platform.args}"/>
                                        </exec>
                                        <zip destfile="${project.build.directory}/powerj-${project.version}-${dist.platform}.zip">
                                            <zipfileset dir="${dist.jpackage}" includes="${dist.image}/**" filemode="755"/>
                                        </zip>
                                        <!-- powerj-<version>-<platform>.zip.sha256, in the format of sha256sum -c. -->
                                        <checksum file="${project.build.directory}/powerj-${project.version}-${dist.platform}.zip"
                                                  algorithm="SHA-256" fileext=".sha256" format="MD5SUM"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows installer (.exe) built from the application image; requires WiX. -->
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="${dist.jpackage.exe}" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="exe"/>
                                            <arg value="--name"/>
                                            <arg value="powerj"/>
                                            <arg value="--app-version"/>
                                            <arg value="${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}"/>
                                            <arg value="--vendor"/>
                                            <arg value="PowerJ"/>
                                            <arg value="--app-image"/>
                                            <arg value="${dist.jpackage}/powerj"/>
                                            <arg value="--win-menu"/>
                                            <arg value="--win-menu-group"/>
                                            <arg value="PowerJ"/>
                                            <arg value="--win-shortcut"/>
                                            <arg value="--win-per-user-install"/>
                                            <arg value="--win-dir-chooser"/>
                                            <arg value="--dest"/>
                                            <arg value="${project.build.directory}/installer"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
