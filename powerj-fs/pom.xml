<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.powerj</groupId>
        <artifactId>powerj-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>powerj-fs</artifactId>
    <name>PowerJ File System</name>

    <properties>
        <!-- Coverage floor of the tests of this module alone (parent pom, jacoco module-check): 80 % of lines and branches (issue #85); a module may measure more. -->
        <coverage.module.line>0.80</coverage.module.line>
        <coverage.module.branch>0.80</coverage.module.branch>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Mutation testing of this module (#96): the root profile `mutation` targets the core; here it targets
             io.powerj.fs, with the tests of this module. combine.self="override" replaces the lists of the root profile
             instead of merging them entry by entry. See docs/quality/mutation.md.
             ./mvnw -Pmutation -pl powerj-fs test-compile org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>io.powerj.fs.*</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>io.powerj.fs.*</param>
                            </targetTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
