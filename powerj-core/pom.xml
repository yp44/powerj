<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.powerj</groupId>
        <artifactId>powerj-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>powerj-core</artifactId>
    <name>PowerJ Core</name>

    <properties>
        <!-- Coverage floor of the tests of this module alone (parent pom, jacoco module-check). Measured 87.9 % / 81.9 % (Linux, JDK 25), about one point of margin; at least 80 % (issue #85). -->
        <coverage.module.line>0.86</coverage.module.line>
        <coverage.module.branch>0.80</coverage.module.branch>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.powerj</groupId>
            <artifactId>powerj-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.powerj</groupId>
            <artifactId>powerj-fs</artifactId>
        </dependency>
        <dependency>
            <groupId>io.powerj</groupId>
            <artifactId>powerj-text</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Only build.properties is filtered: message files contain ${…} and @… that must stay as is. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/build.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/build.properties</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
