<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.powerj</groupId>
    <artifactId>powerj-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PowerJ</name>
    <description>Shell interactif orienté objet en Java</description>

    <modules>
        <module>powerj-api</module>
        <module>powerj-fs</module>
        <module>powerj-core</module>
        <module>powerj-cmdlets</module>
        <module>powerj-fx</module>
        <module>powerj-shell</module>
        <module>powerj-architecture</module>
        <module>powerj-coverage</module>
        <module>powerj-dist</module>
        <module>examples/greet</module>
    </modules>

    <properties>
        <!-- Target Java version. -->
        <java.release>25</java.release>
        <maven.compiler.release>${java.release}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Fixed timestamp of the archives built by the Maven plugins (reproducible builds); set to the release date
             when a version is released. The zip files of powerj-dist and powerj-fx are made by Ant and are not covered. -->
        <project.build.outputTimestamp>2026-10-25T00:00:00Z</project.build.outputTimestamp>

        <junit.version>5.13.4</junit.version>
        <assertj.version>3.27.4</assertj.version>
        <jline.version>4.4.7</jline.version>
        <jacoco.version>0.8.15</jacoco.version>
        <archunit.version>1.5.1</archunit.version>
        <javafx.version>25.0.5</javafx.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-fs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-cmdlets</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-shell</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.powerj</groupId>
                <artifactId>powerj-fx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-reader</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-terminal</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-terminal-ffm</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <!-- All javac lint categories are reported (review C-32). They are warnings for now: the baseline is
                             in docs/quality/lint-baseline.md; the build will fail on new ones once it is clean. A module that
                             sets its own compilerArgs must use combine.children="append". -->
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <!-- Messages in English whatever the machine or POWERJ_LANG (FR-61). -->
                        <systemPropertyVariables>
                            <powerj.language>en</powerj.language>
                        </systemPropertyVariables>
                        <!-- A test that blocks (deadlock, pipeline never closed) must fail, not freeze the build (review
                             C-31). The slowest test takes 1.5 s; one that needs more declares its own @Timeout. -->
                        <properties>
                            <configurationParameters>
                                junit.jupiter.execution.timeout.default = 60 s
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <!-- Not used by the build, but bound by the default lifecycle: pinned for requirePluginVersions. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.12.1</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>PowerJ requires Maven 3.9 or newer.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.release},)</version>
                                    <message>PowerJ requires JDK ${java.release} or newer.</message>
                                </requireJavaVersion>
                                <!-- Review C-32: reproducible dependency and plugin resolution. -->
                                <dependencyConvergence/>
                                <requirePluginVersions>
                                    <banSnapshots>true</banSnapshots>
                                </requirePluginVersions>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Coverage (NFR-05): each module records its tests in target/jacoco.exec (the agent is passed to
                 surefire through argLine); powerj-coverage merges them and enforces the threshold.
                 -Djacoco.skip=true turns it off. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
